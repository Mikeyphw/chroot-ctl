#!/system/bin/sh
set -e
set +u

resolve_moddir() {
  _script_dir="${0%/*}"
  _candidate="$_script_dir/../.."
  if [ -f "$_candidate/module.prop" ] && grep -q '^id=chrootctl-magisk$' "$_candidate/module.prop" 2>/dev/null; then
    cd "$_candidate" 2>/dev/null && pwd
    return 0
  fi

  for _candidate in     "/data/adb/modules/chrootctl-magisk"     "/data/adb/modules_update/chrootctl-magisk"     "/data/adb/ksu/modules/chrootctl-magisk"     "/data/adb/ksu/modules_update/chrootctl-magisk"; do
    if [ -f "$_candidate/module.prop" ] && grep -q '^id=chrootctl-magisk$' "$_candidate/module.prop" 2>/dev/null; then
      echo "$_candidate"
      return 0
    fi
  done

  echo "$_script_dir/../.."
}
MODDIR="$(resolve_moddir)"
TARGET="$MODDIR/bin/chrootctl-python-bootstrap"
export PATH="$MODDIR/system/bin:/system/bin:/system/xbin:/data/adb/magisk:$PATH"

if [ ! -x "$TARGET" ]; then
  echo "missing module executable: $TARGET" >&2
  exit 1
fi

exec "$TARGET" "$@"
