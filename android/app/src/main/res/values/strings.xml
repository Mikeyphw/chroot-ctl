    <string name="help_getting_started_title">Getting started</string>
    <string name="help_getting_started_body">Home checks root and bridge readiness. Install creates a chroot through a preview-first foreground operation. Chroots manages lifecycle, snapshots, users and services. Tools contains catalogs, transfers, logs, repair, diagnostics and support exports.</string>
    <string name="help_operations_title">Operations and cancellation</string>
    <string name="help_operations_body">Long-running work is journaled in Activity and remains visible through foreground notifications. Open an operation to inspect events, cancel active work, or use recovery actions after a failure.</string>
    <string name="help_open_activity_action">Open Activity</string>
    <string name="help_recovery_title">Failure recovery</string>
    <string name="help_recovery_body">Failed, interrupted, blocked or cancelled work can expose Retry now, Retry with fixes, and Restore latest snapshot. Recovery is offered only when the journal contains a safe replay request and a matching snapshot exists.</string>
    <string name="help_storage_title">Imports, exports and snapshots</string>
    <string name="help_storage_body">Android document pickers stage archives without granting broad storage access. Managed artifacts can be copied to a document you choose. Snapshot restore requires typing the chroot name.</string>
    <string name="help_privacy_title">Privacy and support evidence</string>
    <string name="help_privacy_body">The bridge uses an allowlisted protocol rather than arbitrary shell input. Retry requests containing redacted secrets are blocked. Review support and debug previews before exporting evidence.</string>
    <string name="help_api_title">Bridge API reference</string>
    <string name="help_api_body">These are the protocol operations reported by the connected runtime. The list updates after Home refresh and acts as the native replacement for the retired WebUI API page.</string>
    <string name="help_api_unavailable">Refresh Home to load the live operation catalog.</string>
    <string name="logs_title">System logs</string>
    <string name="logs_body">Read a bounded snapshot of the chrootctl log. Live tail polls the same read-only bridge query every three seconds and can be stopped at any time.</string>
